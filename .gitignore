# macOS
.DS_Store

# The Xcode project is generated from project.yml by XcodeGen — see README.
# Committing it meant a build artifact tracked alongside its own source, and the
# two drifted every time either was touched by hand. CI regenerates it on every
# run and never read the committed copy.
SoccerCoachKit.xcodeproj/

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Xcode per-user data
xcuserdata/
*.xcuserdatad/

# Swift Package Manager
.build/
.swiftpm/

# CocoaPods / Carthage (unused today, ignored for safety)
Pods/
Carthage/Build/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
build-signed/

# Local dev backend override (per-machine; never committed)
Config/Local.xcconfig
